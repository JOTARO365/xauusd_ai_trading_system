# ============================================================
# .env.shared — config ที่ทีมใช้ร่วมกัน (behavior/strategy flags)
# ------------------------------------------------------------
# setup.py จะ "เขียนทับ" ค่าเหล่านี้ลง .env (เฉพาะที่ต่าง) เมื่อรัน `python setup.py`
# → owner แก้ที่นี่ + git push → เพื่อน pull + setup = config ตรงกันอัตโนมัติ
#
# ⚠️ ห้ามใส่ secret ที่นี่ (ไฟล์นี้อยู่ใน git!) — setup ไม่แตะ secret อยู่แล้ว:
#     ANTHROPIC_API_KEY · MT5_LOGIN/PASSWORD/SERVER · X_* (twitter) · SUPABASE_* · TRADING_API_* · GEMINI · DATABASE_URL
# ไม่รวม per-account money size (START_BALANCE / LOT / RISK / SYMBOL) — แต่ละคนตั้งเอง
# 🔴 flag พวกนี้เปิด live-trading (บน account ที่ตั้งใน .env ของแต่ละคน) — ใช้ demo
# ============================================================

# ── weekend ──
WEEKEND_RUN=true
WEEKEND_INTERVAL_SECS=1800

# ── multi-symbol engine (WTI ฯลฯ) ──
MULTI_SYMBOL_LIVE=true
MSE_MAX_POSITIONS=3
MSE_MAX_TOTAL=3
ALGO_SL_MULT=WTIUSD:0.7
MSE_SL_MIN_ATR=0.5
MSE_SL_MAX_ATR=4.0
AUTO_SL_PCT_OTHER=0.01

# ── regime / algo entry ──
REGIME_LIVE=true
REGIME_LIVE_TICK=true
REGIME_SHADOW_FILL=true
REGIME_SR_ENTRY=true
REGIME_SR_EXIT=true
REGIME_SR_SIZING=true
REGIME_PENDING=false
REGIME_PENDING_FADE=true
ALGO_MAX_STACK=2
ALGO_MAX_SAME_DIR=1
ALGO_SIZE_STANDDOWN=false

# ── tsmom-d1 ──
TSMOM_LIVE=true
TSMOM_SHADOW=false
TSMOM_COEXIST=true
TSMOM_LONG_ONLY=false

# ── misc behavior ──
DRY_RUN=false
DYNAMIC_TP=true
TRAILING_STOP=true
LESSON_LEARNING=true
