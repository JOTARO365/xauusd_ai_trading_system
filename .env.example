# MT5_SERVER=your_mt5_server_here

# ── PM2 ──────────────────────────────────────────────────────
PM2_APP_NAME=main

# ── Trading Config (10,000 THB ≈ $285) ───────────────────────
# SYMBOL=XAUUSD
SYMBOL=GOLD#
START_BALANCE=50000
LOT_MODE=fixed
FIXED_LOT=0.01
MIN_LOT=0.01
MAX_LOT=0.03
RISK_PER_TRADE=2.0
MAX_DAILY_LOSS=30.0
MAX_OPEN_TRADES=2
# Multi-symbol live engine (2026-07-25) — เปิดจริงบน demo: WTI momentum (edge t=15). stack ได้ 3 ไม้/combo
# gold cap (MAX_OPEN_TRADES=2 ด้านบน) ไม่แตะ — MSE ใช้ override ของตัวเอง. ปิด = MULTI_SYMBOL_LIVE=false
MULTI_SYMBOL_LIVE=true
MSE_MAX_POSITIONS=1
MSE_MAX_TOTAL=0
ALGO_SL_MULT=WTIUSD:0.7
DEFAULT_SL_PIPS=1000
DEFAULT_TP_PIPS=3000
MIN_RR_RATIO=2.0
MAX_PENDING_BUY=2
MAX_PENDING_SELL=2
PENDING_EXPIRY_HOURS=24
CONF_FULL_SIZE_AT=80
CONF_MIN_SCALE=0.5
# EMA_PULLBACK toxicity gate (วิเคราะห์ 2026-06: SL กว้าง/conf ต่ำ → ~0% WR)
EMA_PULLBACK_MAX_SL=1500    # SL pips >= ค่านี้ → block EMA_PULLBACK
EMA_PULLBACK_MIN_CONF=70    # confidence < ค่านี้ → block EMA_PULLBACK
PORTFOLIO_PROTECTION=true
STREAK_PROTECTION=true
DYNAMIC_TP=true
TP_EXT_MAX=4                  # dynamic-TP ขยาย TP ได้สูงสุดกี่ครั้ง/ไม้ (เดิม 2 → 4, 07-23)
TP_EXT_PIPS=400              # ระยะ extend TP ต่อรอบ (fallback เมื่อไม่มีแนว S/R ถัดไป)
TP_EXT_NEAR_PIPS=150         # ราคาห่าง TP ≤ นี้ (pips) จึงพิจารณา extend
TP_EXT_MOMENTUM_MIN=4        # momentum score ≥ นี้ (max 5) จึง extend
TP_EXT_COOLDOWN_SECS=900     # cooldown ระหว่าง extend แต่ละครั้ง (วินาที)
TP_EXT_SL_LOCK_PIPS=200      # trail SL ห่างราคา X pips เมื่อ extend (floor ด้วย SL_MIN_GAP)
MAX_LOSING_STREAK=3
STREAK_MIN_CONFIDENCE=68
HEDGE_BUFFER_PIPS=10000
MIN_AI_EQUITY=135

# ── Supabase (Owner — เข้า DB ตรง) ───────────────────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# ── API Proxy (User mode — ถ้าตั้งค่านี้จะข้าม Supabase ด้านบน)
# TRADING_API_URL=https://your-proxy.onrender.com
# TRADING_API_KEY=your_trading_api_key_here

# ── Gemini (Google AI) — สำหรับ news embedding + vector search ──
# รับ API key ฟรีที่: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Breakeven ────────────────────────────────────────────────
BE_TRIGGER_R=1.2
BE_BUFFER_PIPS=300
BE_CONFIRM_CYCLES=5
HTF_BE_TRIGGER_R=2.0
HTF_BE_BUFFER_PIPS=1000

# ── Trailing Stop (Swing Low/High — Higher TF) ───────────────
TRAILING_STOP=true
TRAILING_ATR_TF=D1
TRAILING_ATR_MULT=0.3
TRAILING_MIN_PROFIT_R=1.5
TRAILING_LOOKBACK=8

# ── RAG-based Lesson Retrieval ───────────────────────────────
LESSON_LEARNING=true

# ── DRY_RUN mode ─────────────────────────────────────────────
DRY_RUN=false

# ── REGIME_LIVE — algo entry mode (2026-07-19) ───────────────
# algo (momentum-in-TREND) = ตัวเดียวที่วาง order; LLM→sentiment; pending/ZRE/swing ปิดอัตโนมัติ.
# lot 0.01 (fixed), daily-cap/SL guard เดิมทำงาน. ⚠️ algo ยังไม่มี validated edge → เก็บ data.
# kill switch = REGIME_LIVE=false (live-reload, ไม่ต้อง restart). monitor: python scripts/regime_monitor.py
REGIME_LIVE=true
# per-tick executor (2026-07-20, user request) — daemon เช็คราคา vs Donchian level ทุก REGIME_TICK_INTERVAL_SEC
# realtime เข้าเร็วกว่ารอ bar-close. per-cycle ปิดอัตโนมัติเมื่อ tick ON. ⚠️ thread start ตอน boot → ต้อง restart
# kill = REGIME_LIVE_TICK=false. ยังคง lot 0.01 + daily-cap + SL/TP ในตัว
REGIME_LIVE_TICK=true
REGIME_LOOP_SECS=5           # main loop 5 วิ (จัดการไม้/trailing/journal/pending gate responsive; entry=tick 3s แยก)
# ── algo v2 (2026-07-20, DESIGN_algo_v2.md) — S/R-aware entry/exit ─────────────
# P-B fade → journal shadow (0 order): เก็บ counterfactual fade data (BUY@support/SELL@resistance + veto/gate)
REGIME_SR_ENTRY=true
# P-D exit: TP ยิงแนว S/R ตามความสำคัญ (H1 ใกล้/W1 ไกล) + trailing ใต้ support/เหนือ resistance − 0.3ATR
REGIME_SR_EXIT=true
# P-E sizing: lot ไม้ ALGO = risk-based (equity × RISK_PCT / sl_pips, cap MAX_RISK_PCT, clamp MIN/MAX_LOT)
REGIME_SR_SIZING=true
REGIME_SR_RISK_PCT=0.005     # 0.5% ของ equity ต่อไม้ (โตตามทุน, floor MIN_LOT)
# P-C pending regime-routed (2026-07-20, user "เปิดทั้ง fade+breakout"): entry เปลี่ยนเป็น pending orders
# → tick/per-cycle executor ยืนดูอัตโนมัติ (ไม่เข้าซ้ำ). broker fill ตอนราคาแตะแนว
# TREND → BUY_STOP/SELL_STOP breakout ที่ Donchian
REGIME_PENDING=false        # hybrid (2026-07-20): TREND→tick market execute / RANGE→fade pending (ไม่ใช้ STOP straddle)
# RANGE → BUY_LIMIT@แนวรับแข็ง / SELL_LIMIT@แนวต้านแข็ง (veto break_pct≥60) + cancel ตอนราคาใกล้+momentum break
# ⚠️ RANGE fade ยังไม่ผ่าน validation — เปิดเก็บ data จริง (lot risk 0.5%, MAX 0.03). kill = flag=false
REGIME_PENDING_FADE=true
# SHADOW-FILL (2026-07-20, user "เข้า order แม้ไม่มีทุน"): algo วาง order แบบ paper (ไม่วางจริง/ไม่ใช้ทุน/ไม่เช็ค margin)
# เฉพาะไม้ ALGO — ไม้จริง legacy บริหารปกติ (DRY_RUN=false). journal เก็บ counterfactual. kill = false. เติมทุนแล้วปิด = เทรดจริง
REGIME_SHADOW_FILL=true
ALGO_MAX_STACK=1            # ถือไม้ ALGO พร้อมกันได้ 2 (margin/ทุน cap เอง; ไม้ปิด→เข้าใหม่อัตโนมัติ)
ALGO_MAX_SAME_DIR=1         # ไม้ ALGO ทิศเดียวกันสูงสุด (1 = กัน 2 engine เข้าซ้อนทางเดียว; ฝั่งตรงข้ามยังเข้าได้)

# SMALL-ACCOUNT GUARD (2026-07-21): ก่อนเปิดไม้ ALGO เช็คว่าถ้าเปิดที่ MIN_LOT จะเสี่ยง > เพดานไหม
# (min-lot ใหญ่เกินทุน+SL นี้) → เกิน = ข้ามไม้ (stand down) ไม่ over-risk. ramp อัตโนมัติตามทุน.
# ที่ทุน ~1.4k฿ ตอนนี้ = ข้ามทุกไม้ (เสี่ยง 9-52%); พอทุนโต ~13k→27k→54k ไม้ค่อยๆ เปิดได้. kill = false.
# ⚠️ DEMO: ปิด guard ให้บอทรันปกติ (เข้าทุกไม้ = เก็บ data ครบ ไม่เอนเอียง SL size).
# 🔴 ต้องเปิดกลับ (=true) ก่อนใช้เงินจริง — ไม่งั้นบัญชีเล็กไม่มีตัวป้องกัน over-risk
ALGO_SIZE_STANDDOWN=false
ALGO_MAX_TRADE_RISK_PCT=0.02   # เพดาน risk/ไม้ ALGO 2% (ใช้เมื่อ guard=true)

# TSMOM-D1 (2026-07-21) — edge เดียวที่ validated (~31 กลยุทธ์). time-series momentum รายวัน position-based.
# TSMOM_LIVE=true → เปิด position จริงตาม ensemble sign(close_D1−close_D1[L]) + ปิด momentum intraday+fade
# (กัน conflict). tiny-live บน demo เก็บ forward data. exit=flip, SL=chandelier 3×ATR(D1). kill=false (live-reload).
# ⚠️ edge modest+partly-beta = forward-validation ไม่ใช่ money-maker. เปิด stand-down guard กลับก่อนเงินจริง
TSMOM_LIVE=true
TSMOM_SHADOW=false
TSMOM_COEXIST=true
TSMOM_LOOKBACKS=21,63,126        # เพิ่ม short-horizon (08-07)
TSMOM_CONFIRM_LB=21               # short-term confirm: ไม่เข้าสวน momentum 21วัน (0=off)
TSMOM_SL_ATR=3.0
# short-term H4 winners (08-07 backtest: H4 +EV, H1/M15 −EV). per-combo "algo:SYM=TF" คั่น ;
ALGO_TF_OVERRIDE=regime_momentum:BTCUSD=H4;tsmom_d1:XAGUSD=H4
ALGO_LB_OVERRIDE=tsmom_d1:XAGUSD=6,18,42        # lookbacks (บาร์ TF) ต่อ combo สำหรับ tsmom intraday

# TSMOM_SL_PIPS > 0 = SL คงที่ (points) แทน chandelier ATR — สำหรับบัญชีเล็กให้เปิด order ได้
# 0 = ใช้ ATR (demo 50k). บัญชี 1000฿: ตั้ง ~500 (risk ~18%/ไม้, พอเปิดได้) ⚠️ SL แคบ = edge หาย
# (backtest: SL<2000p → WR 2-18% โดน noise รูด) = execution-test ไม่ใช่ระบบทำกำไร
TSMOM_SL_PIPS=0

# ── CHART_SHADOW (A/B test — Phase 1 token optimization) ─────
# true  = ยิง terse-variant คู่ขนานเทียบ verbose → log logs/shadow_chart.jsonl
#         (ของจริงใช้ output เดิมตลอด — ไม่กระทบการเทรด แต่จ่าย token เพิ่มชั่วคราว)
# ดูผล: python scripts/shadow_report.py | ปิดเมื่อเก็บ ~100+ cycles พอแล้ว
CHART_SHADOW=false  # ปิด 07-03: ได้ข้อสรุปแล้ว (828 samples, match 22% = Haiku แทนไม่ได้)

# ── NNLB mode (No-Risk-No-Lamborghini) ───────────────────────
# ⚠ NNLB = ข้าม gates — lot คำนวณจากกำไรสะสม (profit-tier)
# *** BASE_EQUITY / EQUITY_PER_LOT = USD → code คูณ rate แปลงเป็นสกุลบัญชีอัตโนมัติ ***
#     บัญชีนี้ THB (rate≈36): ค่า USD ด้านล่าง ×36 = ค่า THB จริง
# profit-tier: กำไรทุก EQUITY_PER_LOT → +0.01 lot (cap MAX_LOT=0.03)
#   equity ≤ $1 (≈36฿)    → skip (ทุนไม่พอ)
#   กำไร $278 (≈10,000฿)  → 0.02 lot
#   กำไร $556 (≈20,000฿)  → 0.03 lot (capped)
NNLB_MODE=false
NNLB_BASE_EQUITY=1
NNLB_EQUITY_PER_LOT=278
NNLB_MAX_LOSS_PCT=5

# ── X Accounts / Keywords ────────────────────────────────────
X_ACCOUNTS_TO_FOLLOW=cnnbrk,BBCBreaking,ZeroHedge,markets,kun_purich
X_KEYWORDS=XAUUSD,gold,XAU,bullion,Fed,inflation,Trump,Iran,Israel,ceasefire,geopolitical,war,oil,crude,CPI,rate cut,Hormuz,CENTCOM,Kharg,PPI,FOMC,Pakistan,Pezeshkian,Geneva,bitcoin,BTC,ethereum,ETH,crypto,halving,stablecoin

ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# NEWS_GATE — News Impact score ปรับ conf floor (เปิด 2026-07-05)
NEWS_GATE=true

# Specialist Layer-A shadow data collection (2026-07-15) — 0 order/decision impact, 0 token; appends logs/spec_shadow.jsonl for replay-validator
SPECIALIST_SHADOW=true

# ZRE Zone Re-Entry RR>=2 (v2 fixed-SL) — ENABLE live (2026-07-16, user override replay 'shadow-first')
# containment: trend-align-only, grade A/B score>=78, fresh<=3, proximity 0.4%, cap 2/side + daily cap
ZONE_REENTRY_ENABLED=true
ZONE_REENTRY_SHADOW=true
ZRE_TREND_ALIGN_ONLY=true

# (a) NEWS contradiction dampener — ENABLE (2026-07-16) — ผ่อน oppose-penalty เมื่อ price/flow สวนข่าว
# rare+bounded (floor <=8), gate อื่นคงครบ; แก้เคส 4060 (SELL conf62 โดน NEWS_GATE floor 70)
NEWS_CONTRA_ENABLED=true

# regime-aware vol-target sizing (enabled 2026-07-18, user request)
REGIME_SIZING=true

SPEECH_SUMMARY=true        # Phase 3: dashboard สรุป speech ด้วย Haiku (on-demand, cached ~เศษสตางค์/เดือน); true=เปิด

# ── Batch B forward shadow (log-only, 0 order — ไม่กระทบการเข้า order ทอง) ──
SHADOW_ENGINE=true
SHADOW_TSMOM=true
BE_MAX_TRIGGER_PIPS=1500
SL_MIN_GAP_PIPS=800
AUTO_SL_PIPS=0
MAX_TRADES_PER_DAY=6
MIN_TECH_CONF=62
ASIAN_MIN_CONF=72
COUNTER_SPIKE_PIPS=500
# Ecosystem Monitor RSI reversal thresholds (dashboard display-only, 0 token)
ECO_RSI_OB=70
ECO_RSI_OS=30
# Weekend gap-monitor spot source: XM 24/7 gold symbol (ว่าง = auto keyword GOLD24-7#). fallback = crypto token (PAXG/XAUT)
GOLD_SPOT_247_SYMBOL=
NEWS_BIAS_MIN_CONF=55
NEWS_CONFIRM_PIPS=500
NEWS_OVERRIDE_MIN_CONF=50
HTF_REVERSAL_MIN_CONF=70
TREND_CONT_CONF=65
TREND_CONT_MAX_DIST_PCT=0.3
HTF_DIRECTION_BLOCK=true
AUTO_SL_PROTECT=true
EMA_PULLBACK_BLOCK=true
NEWS_FIRST=true
HTF_FADE_BLOCK=true
NEWS_OVERRIDE_TREND=true
NNLB_FASTPATH=true
MOMENTUM_RIDE=true
WEEKEND_RUN=true

# --- 2026-07-26: 8 คีย์เพิ่มโดย setup.py (sync จาก .env.example) ---
ALGO_ENTRY_HOURS=          # allow-list ชม UTC ที่ intraday algo เข้าได้ (เช่น 0-13=Asian+London, 0-7=Asian). ว่าง=ทุกชม (default)
MSE_SL_MIN_ATR=0.5        # clamp SL ≥ 0.5×ATR (safety กัน ATR เพี้ยน→SL แคบโดน stop ทันที; 0=ปิด). ไม่แตะ edge เคสปกติ
MSE_SL_MAX_ATR=4.0        # clamp SL ≤ 4×ATR (safety กัน SL กว้าง→risk ระเบิด; 0=ปิด). WTI ปกติ SL~1×ATR อยู่กลางช่วง
WEEKEND_INTERVAL_SECS=1800  # loop ห่างวันหยุด (วินาที) — AI ยังรัน sentiment/BTC แต่ลด token
AUTO_SL_PCT_OTHER=0.01   # auto-SL คู่ non-gold (orphan sl=0) = % ของราคา (ทองใช้ AUTO_SL_PIPS เดิม)
# --- Structural SL (แก้ "เข้าถูกทางแต่โดน SL ก่อน": วาง SL ที่ปลายไส้ D1/H4 ปิดล่าสุด เสมอ + min lot) ---
# backtest (SL ปลายไส้, คง TP, pick=farthest): ทุกคู่ SL-hit ลด ~65-73%→~26-30%; expR GOLD/JPY/EUR ดีขึ้น, BTC/WTI ~เสมอ
STRUCTURAL_SL_GOLD=true        # gold ALGO-mom (regime_executor/tick)
STRUCTURAL_SL_MSE=true         # MSE momentum + tsmom คู่ MSE
STRUCTURAL_SL_TFS=H4,D1        # timeframe ไส้ที่พิจารณา
STRUCTURAL_SL_PICK=farthest    # farthest=ไส้ไกลสุด(D1, กัน noise มากสุด, backtest ดีสุด) | nearest=ไส้ใกล้สุด(H4, SL แคบ)
STRUCTURAL_SL_BUFFER_ATR=0.3   # เผื่อพ้นไส้ × ATR
TSMOM_LONG_ONLY=true       # (legacy) ถูก override โดย TSMOM_DIR_MODE ถ้าตั้ง
TSMOM_DIR_MODE=long        # ทิศ tsmom: long(BUY เท่านั้น)/short(SELL เท่านั้น)/both(symmetric). dropdown ใน dashboard เลือกได้. backtest: ขา SELL −EV → long
TSMOM_HEDGE_PENDING=false  # โหมด long/short → วาง pending LIMIT ทิศตรงข้ามที่โซน S/R ปลอดภัย (long→SELL_LIMIT@resistance) + SL 0.6ATR + TP RR2. kill=false
TSMOM_MIN_ADX=0            # เข้าเฉพาะ ADX(D1)≥นี้ (0=off; แรงแต่ n น้อย=overfit)
TSMOM_MIN_VOLPCT=0         # เข้าเฉพาะ vol_percentile(D1)≥นี้ (0=off) → intraday momentum engine ทำงาน "คู่" TSMOM (ไม่ hand-off) = เข้าได้ทั้ง BUY+SELL

# --- 2026-07-26: broker symbols (probe_universe → .env) ---
BROKER_SYM_XAGUSD=SILVER#
BROKER_SYM_XAUEUR=XAUEUR#
BROKER_SYM_XAUJPY=XAUJPY#
BROKER_SYM_AUDUSD=AUDUSD#
BROKER_SYM_USDCHF=USDCHF#
BROKER_SYM_USDJPY=USDJPY#
BROKER_SYM_EURUSD=EURUSD#
BROKER_SYM_BTCUSD=BTCUSD#
BROKER_SYM_WTIUSD=OILCash#
ALGO_ENTRY_MIN_GAP_ATR=1.0        # กัน stack เกาะจุดเดิม: skip เข้าใหม่ถ้ามีไม้ algo ทิศเดียวเปิดใน n×ATR (0=ปิด)

# ── SENTIMENT BIAS (gold) — LLM ให้คะแนน −100..+100 (ข่าว+พื้นฐาน) → bias ทิศ algo ทอง ──
# kill switch = SENTIMENT_BIAS=false. gold-only (regime_tick/executor). data-primacy: sentiment แค่ veto/dampen ทิศผิด ไม่ปั้น signal
SENTIMENT_BIAS=false              # เปิด = ให้ sentiment มีผลต่อทิศ/lot ของ algo ทอง
SENTIMENT_BIAS_DEADBAND=20        # |score| < นี้ = neutral (เข้า 2 ทางเหมือนเดิม)
SENTIMENT_BLOCK_ABOVE=60          # |score| ≥ นี้ + สวนทิศ = veto (ห้ามเข้าทิศผิด, รอทิศถูก). 0=ปิด (soft ล้วน)
SENTIMENT_LOT_FLOOR=0.5           # lot สวนทิศต่ำสุด = floor × lot ปกติ (soft)
SENTIMENT_MARGIN_MULT=0.5         # break สวนทิศต้องเกิน level อีก (มากสุด) นี้ × ATR (soft, regime_tick)
SENTIMENT_REFRESH_MIN=30          # cache score กี่นาที (กัน LLM ยิงถี่)
SENTIMENT_MODEL=claude-sonnet-4-6 # โมเดลให้คะแนน sentiment

# ── REGIME NARRATIVE AUTO — LLM เขียน narrative ของ macro_regime.md ใหม่ทุกเช้าจากข่าวสด ──
# จันทร์=baseline สัปดาห์ · วันอื่น=ติดตามสถานการณ์ใหม่ (ไม่ recap). เขียนเฉพาะโซน narrative
# (ไม่แตะ MACRO_AUTO block/header) + backup .bak + log. kill = false. 1 LLM call/วัน
REGIME_NARRATIVE_AUTO=false        # เปิด = auto-rewrite narrative ทุกเช้า
REGIME_NARRATIVE_MODEL=claude-sonnet-4-6
REGIME_NARRATIVE_HOUR=7            # รันครั้งแรกหลังชั่วโมงนี้ (local) = เช้า

# XAU-XAG pairs-trade (stat-arb 2-leg market-neutral, 08-07). WR57% OOS+2.45 t1.89. gate=PAIRS_LIVE
PAIRS_LIVE=false        # default OFF; เปิด=วาง order จริง 2 legs
PAIRS_SYMBOLS=XAUUSD:XAGUSD
PAIRS_WIN=120
PAIRS_Z_IN=2.0
PAIRS_Z_OUT=0.5
PAIRS_Z_STOP=3.5
PAIRS_XAU_LOT=0.0
PAIRS_DISASTER_ATR=6.0

# confluence_15m gold: session filter (UTC ชม, NY=ทองวิ่ง; ว่าง=ทุกชม) — exp_R ~1.7× (08-07)
CONF15M_SESSION=13-21

# event-engine (NFP/CPI/FOMC) SHADOW-first: log สิ่งที่จะทำ เก็บ data ก่อน (true=แตะ trade)
EVENT_ENGINE_LIVE=false
EVENT_PRE_MIN=30
EVENT_POST_MIN=120

# loss-adaptive (แพ้ติด→เช็ค sentiment→ปรับ dir/pause) — SHADOW-first
LOSS_ADAPTIVE_LIVE=false
LOSS_STREAK_RECHECK=3
LOSS_ADAPTIVE_COOLDOWN_MIN=240
# LLM algo-router (auto-swap algo ตามสภาพ) — ENABLE=เปิด LLM(ใช้ token), LIVE=สลับ switch จริง. shadow-first
ALGO_ROUTER_ENABLE=false
ALGO_ROUTER_LIVE=false
ALGO_ROUTER_EVERY_HRS=6
ALGO_ROUTER_MIN_GAP_MIN=60

# force-close ทุกไม้เมื่อกำไร X% ของ balance (lock กำไร)
FORCE_CLOSE_PROFIT=false
FORCE_CLOSE_PROFIT_PCT=100
FORCE_CLOSE_MIN_CAPITAL=20000   # force-close เฉพาะทุน<ค่านี้ (โตเล็ก→เกณฑ์)
CAPITAL_GATE_ENABLE=false   # ทุน<FLOOR บล็อกไม้เสี่ยง>MAX%ของ equity (กันล้างทุนเล็ก; WTI/BTC ผ่าน ทองบล็อก)
CAPITAL_GATE_FLOOR=20000
CAPITAL_GATE_MAX_RISK_PCT=15
FF_SIZING_ENABLE=true   # ทุน<CAPITAL_GATE_FLOOR ใช้ fixed-fractional (risk%คงที่ ลด DD); ≥ = fixed-lot
FF_RISK_PCT=1.0
ATR_SL_SMALL_CAP=true   # ทุน<CAPITAL_GATE_FLOOR → ATR SL(native) แทน structural → FF คุม DD ได้ (override structural-SL rule เฉพาะทุนเล็ก)

# trailing หลวมสำหรับ momentum algo (ปล่อยถึง TP)
TRAILING_MOM_MULT=3.0
TRAILING_MOM_MIN_R=1.9

# momentum algo = fixed SL/TP let-run to TP (no BE/trail) — backtest strongly better
MOM_LET_RUN=true
